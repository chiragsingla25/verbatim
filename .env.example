# Copy to .env.local for SPA dev. Never commit the filled file.
# Server secrets live in Supabase Edge Function secrets and GitHub Actions secrets, NOT here.

# ---- Supabase (SPA — safe to ship; RLS-gated) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase Edge Function secrets (set with `supabase secrets set`, not in the SPA) ----
# SUPABASE_SERVICE_ROLE_KEY=        # ingestion write-back / admin ops only
# LLM_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint:
#                                             #   OpenRouter free, Groq, or http://localhost:11434/v1 for Ollama
# LLM_API_KEY=                      # empty is fine for local Ollama
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free   # or qwen2.5:7b / llama3.1:8b for Ollama
# STORAGE_WEBHOOK_SECRET=           # shared secret the Storage webhook signs with
# GITHUB_DISPATCH_TOKEN=            # fine-grained PAT with repo dispatch scope
# GITHUB_DISPATCH_REPO=<user>/verbatim

# ---- GitHub Actions secrets (ingestion job) ----
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Embeddings ----
# No key. Query-time: Supabase built-in `gte-small`. Ingest-time: `thenlper/gte-small`
# via sentence-transformers in the Action. Both sides MUST use the same model (384-dim).

# ---- App ----
VITE_APP_BASE=/verbatim/           # GitHub Pages project path; router basename + bundler base

# ---- Observability (optional, Phase 3+) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
