# Copy to .env.local and fill. Never commit the filled file.

# --- SPA (public, RLS-gated) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE=/verbatim/

# --- Edge Function secrets: `supabase secrets set KEY=value` ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free
STORAGE_WEBHOOK_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=

# --- Local tooling (Phase 1 build; never committed) ---
SUPABASE_DB_URL=          # Supabase > Connect > Session pooler URI (postgresql://...:5432/postgres)
SUPABASE_ACCESS_TOKEN=    # Supabase > Account > Access Tokens — for `supabase functions deploy`

# --- GitHub Actions repo secrets (Settings > Secrets and variables > Actions) ---
# ingest.yml:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ci.yml also needs: LLM_BASE_URL, LLM_API_KEY, LLM_MODEL (same values as above)
