# Copy to .env.local (Next.js) and fill with real values. Never commit the filled file.
# The Modal job reads the same names from Modal secrets; production reads them from the
# Supabase / Vercel dashboards.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only (ingestion write-back, admin ops). NEVER expose to the client.

# ---- LLM (pick one provider, fill its key) ----
LLM_PROVIDER=gemini                 # gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Embeddings (MUST match between the Modal job and the TS query path) ----
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ---- Reranker ----
RERANK_PROVIDER=cohere              # cohere | jina
COHERE_API_KEY=
JINA_API_KEY=

# ---- Modal (ingestion job) ----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
STORAGE_WEBHOOK_SECRET=             # shared secret the Supabase Storage webhook signs requests with

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Tracing (Phase 3 / pre-launch, optional in dev) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
