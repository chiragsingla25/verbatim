# Copy to .env.local. The SPA needs only these — both are public (RLS-gated).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE=/verbatim/

# Server secrets are NOT kept in a local file. Reference only:
#
# Supabase Edge Function secrets  (`supabase secrets set KEY=value`)
#   LLM_BASE_URL            https://api.groq.com/openai/v1   (or an OpenRouter / local Ollama URL)
#   LLM_API_KEY             gsk_...   (your Groq key; empty for Ollama)
#   LLM_MODEL               llama-3.3-70b-versatile
#   STORAGE_WEBHOOK_SECRET  openssl rand -hex 32
#   GITHUB_DISPATCH_TOKEN   fine-grained PAT, Contents: write
#   GITHUB_DISPATCH_REPO    <user>/verbatim
#
# GitHub Actions repo secrets  (Settings -> Secrets and variables -> Actions)
#   ingest.yml   SUPABASE_URL  SUPABASE_SERVICE_ROLE_KEY
#   ci.yml       LLM_BASE_URL  LLM_API_KEY  LLM_MODEL
